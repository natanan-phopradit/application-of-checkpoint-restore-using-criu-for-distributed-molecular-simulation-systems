#define each variables and copy to .env
ARTEMIS_AUTH=[Username]:[Password]
ARTEMIS_GETCOUNT_TARGET=/console/jolokia/read/org.apache.activemq.artemis:broker=!%22CoordinationServer!%22,component=addresses,address=!%22WorkQueue!%22,subcomponent=queues,routing-type=!%22anycast!%22,queue=!%22WorkQueue!%22/DurableMessageCount
ARTEMIS_PORT=8161
COORDINATIONSERVER_PORT=65096
COORDINATIONSERVER_URL=[IP_ADDRESS]
GMX_PATH=/usr/local/gromacs/bin/gmx
WORKQUEUE_URL=tcp://[IP_ADDRESS]:61616
